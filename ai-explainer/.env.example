# Google Gemini API Key (get from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Internal shared secret for authorized service-to-service calls
INTERNAL_SERVICE_SECRET=dev-internal-secret-2026

# Host and port binding (bind to 127.0.0.1 for local isolation)
HOST=127.0.0.1
PORT=8000
