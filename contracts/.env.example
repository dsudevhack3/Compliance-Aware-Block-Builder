# Ethereum Mainnet RPC URL for Anvil forking
# You can obtain a free-tier API key from Alchemy (https://www.alchemy.com) or Infura (https://www.infura.io)
# Note: For local development, public fallback RPCs (e.g. https://eth.llamarpc.com) may also be used.
MAINNET_FORK_RPC_URL="https://eth-mainnet.g.alchemy.com/v2/YOUR_API_KEY"

# Pinned finalized Ethereum mainnet block for reproducible fork state (October 2024)
MAINNET_FORK_BLOCK_NUMBER=21000000

# Local Anvil RPC endpoint
ANVIL_RPC="http://127.0.0.1:8545"
