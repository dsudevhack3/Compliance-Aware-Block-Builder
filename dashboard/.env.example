# API base URL for Fastify backend
NEXT_PUBLIC_API_URL=http://localhost:3002

# Optional WebSocket URL (defaults to WS counterpart of NEXT_PUBLIC_API_URL)
# NEXT_PUBLIC_WS_URL=ws://localhost:3002/ws

# Admin API Key for authenticated actions (policy activate, simulator trigger)
NEXT_PUBLIC_ADMIN_API_KEY=dev-admin-secret-2026
