# PostgreSQL connection string
DATABASE_URL=postgres://username:password@localhost:5432/compliance_builder

# Fastify server host & port (bind to 127.0.0.1 for localhost safety)
HOST=127.0.0.1
PORT=3002

# Allowed CORS origins (comma-separated, no wildcards in production)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Administrative API key for policy switching and demo controls
ADMIN_API_KEY=dev-admin-secret-2026

# Shared secret for internal AI explainer service calls
INTERNAL_SERVICE_SECRET=dev-internal-secret-2026

# Rust compliance engine configuration
ENGINE_URL=http://127.0.0.1:3001/screen
ENGINE_API_KEY=dev-engine-secret-2026

# AI Explainer endpoint
AI_EXPLAINER_URL=http://127.0.0.1:8000/explain
