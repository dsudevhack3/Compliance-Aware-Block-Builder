# ==============================================================================
# Compliance-Aware Block Builder — Environment Configuration Template
# ==============================================================================

# Ethereum Mainnet RPC URL for Anvil Forking
# Obtain a free-tier API key from Alchemy (https://www.alchemy.com) or Infura (https://www.infura.io)
# e.g., https://eth-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
# A public endpoint like https://eth.llamarpc.com can also be used for quick local dev.
MAINNET_FORK_RPC_URL="https://eth-mainnet.g.alchemy.com/v2/YOUR_API_KEY"

# Pinned finalized Ethereum mainnet block (October 2024) for deterministic, reproducible replay
MAINNET_FORK_BLOCK_NUMBER=21000000

# Local Anvil RPC endpoint
ANVIL_RPC="http://127.0.0.1:8545"

# Database Connection (PostgreSQL)
DATABASE_URL="postgres://postgres:password@localhost:5432/compliance_builder"

# Redis Cache URL
REDIS_URL="redis://127.0.0.1:6379"

# Core Service Endpoints
ENGINE_URL="http://127.0.0.1:3001"
API_URL="http://127.0.0.1:3002"
RELAY_URL="http://127.0.0.1:3003"
AI_EXPLAINER_URL="http://127.0.0.1:8000"

# Service API Secrets
ENGINE_API_KEY="dev-engine-secret-2026"
ADMIN_API_KEY="dev-admin-secret-2026"
