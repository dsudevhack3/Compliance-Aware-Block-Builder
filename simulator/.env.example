# Local Anvil RPC endpoint (forked devnet)
ANVIL_RPC=http://127.0.0.1:8545

# Ethereum Mainnet RPC URL for Anvil forking
# Requires a free-tier API key from Alchemy (https://alchemy.com) or Infura (https://infura.io)
# Note: For local development, public fallback RPCs (e.g. https://eth.llamarpc.com) may also be used.
MAINNET_FORK_RPC_URL="https://eth-mainnet.g.alchemy.com/v2/YOUR_API_KEY"
MAINNET_FORK_BLOCK_NUMBER=21000000

# Compliance Engine endpoint & API key
ENGINE_URL=http://127.0.0.1:3001/screen
ENGINE_API_KEY=dev-engine-secret-2026

# PostgreSQL connection string (for attribution worker)
DATABASE_URL=postgres://username:password@localhost:5432/compliance_builder
